generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  GOODS
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum AmountType {
  PERCENT
  FIXED
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(CUSTOMER)
  active              Boolean   @default(true)
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer      Customer?
  statusChanges SubscriptionStatusHistory[]
  payments      Payment[]
  auditLogs     AuditLog[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  userId    Int?     @unique
  createdAt DateTime @default(now())

  user          User?          @relation(fields: [userId], references: [id])
  subscriptions Subscription[]
  invoices      Invoice[]
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  type       ProductType @default(SERVICE)
  salesPrice Decimal     @db.Decimal(12, 2)
  costPrice  Decimal     @default(0) @db.Decimal(12, 2)
  notes      String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  variants          ProductVariant[]
  taxes             Tax[]
  discounts         Discount[]
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]

  @@index([name])
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  attribute  String
  value      String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]

  @@unique([productId, attribute, value])
}

model Tax {
  id     Int        @id @default(autoincrement())
  name   String     @unique
  type   AmountType @default(PERCENT)
  rate   Decimal    @db.Decimal(12, 2)
  active Boolean    @default(true)

  products Product[]
}

model Plan {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  price         Decimal       @db.Decimal(12, 2)
  billingPeriod BillingPeriod
  minQuantity   Int           @default(1)
  startDate     DateTime      @db.Date
  endDate       DateTime?     @db.Date
  autoClose     Boolean       @default(false)
  closable      Boolean       @default(true)
  pausable      Boolean       @default(false)
  renewable     Boolean       @default(true)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())

  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

model Discount {
  id          Int           @id @default(autoincrement())
  name        String
  type        AmountType
  value       Decimal       @db.Decimal(12, 2)
  minPurchase Decimal?      @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime      @db.Date
  endDate     DateTime?     @db.Date
  usageLimit  Int?
  usedCount   Int           @default(0)
  scope       DiscountScope
  productId   Int?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  product Product? @relation(fields: [productId], references: [id])

  @@index([active, startDate])
}

model QuotationTemplate {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  planId       Int
  validityDays Int      @default(30)
  notes        String?
  createdAt    DateTime @default(now())

  plan  Plan                    @relation(fields: [planId], references: [id])
  lines QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id         Int  @id @default(autoincrement())
  templateId Int
  productId  Int
  variantId  Int?
  quantity   Int  @default(1)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])
}

model Subscription {
  id                  Int                @id @default(autoincrement())
  number              String             @unique
  customerId          Int
  planId              Int
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime           @db.Date
  expiryDate          DateTime?          @db.Date
  nextInvoiceDate     DateTime?          @db.Date
  quotationValidUntil DateTime?          @db.Date
  paymentTermDays     Int                @default(15)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  customer Customer                    @relation(fields: [customerId], references: [id])
  plan     Plan                        @relation(fields: [planId], references: [id])
  lines    SubscriptionLine[]
  invoices Invoice[]
  history  SubscriptionStatusHistory[]

  @@index([status])
  @@index([customerId])
  @@index([nextInvoiceDate])
}

model SubscriptionLine {
  id             Int     @id @default(autoincrement())
  subscriptionId Int
  productId      Int
  variantId      Int?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
}

model SubscriptionStatusHistory {
  id             Int                 @id @default(autoincrement())
  subscriptionId Int
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  changedById    Int?
  note           String?
  createdAt      DateTime            @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id])

  @@index([subscriptionId])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  number         String        @unique
  subscriptionId Int
  customerId     Int
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  lastReminderAt DateTime?
  reminderCount  Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([issueDate])
}

model InvoiceLine {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  productId      Int?
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime      @db.Date
  note         String?
  recordedById Int?
  createdAt    DateTime      @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User?   @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}

model Counter {
  key   String @id
  value Int
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  data      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}
